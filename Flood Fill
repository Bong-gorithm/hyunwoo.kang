class Solution {
    public int[][] floodFill(int[][] image, int sr, int sc, int newColor) {
        if (image[sr][sc] != newColor) {
            dfs(image, sr, sc, image[sr][sc], newColor);
        }
        return image;
    }

    public void dfs(int[][] image, int r, int c, int origin, int newColor) {
        if (r < 0 || c < 0 || r >= image.length || c >= image[0].length
             || image[r][c] != origin) return;

        image[r][c] = newColor;

        dfs(image, r - 1, c, origin, newColor);
        dfs(image, r + 1, c, origin, newColor);
        dfs(image, r, c - 1, origin, newColor);
        dfs(image, r, c + 1, origin, newColor);
    }
}

